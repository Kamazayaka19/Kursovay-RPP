# Скопируйте в .env и заполните. Файл .env не кладите в git.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mfc-queue.example.ru,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://mfc-queue.example.ru
DJANGO_DB_PATH=/data/db.sqlite3
MFC_LK_URL=https://адрес-личного-кабинета
MFC_QR_SECRET=замените-секрет-qr-таблички
